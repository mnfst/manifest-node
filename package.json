{
  "name": "manifest",
  "version": "7.0.0",
  "description": "Repair eligible failed API calls made by Node HTTP clients.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "manifest": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONTRACT.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts src/register.ts src/bin.ts --format esm,cjs --dts --clean",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx --test tests/live.test.ts",
    "version-packages": "changeset version && node scripts/sync-version.mjs && npm install --package-lock-only --ignore-scripts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.0.0",
    "axios": "^1.7.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnfst/manifest-node.git"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
